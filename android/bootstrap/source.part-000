#!/usr/bin/env bash
set -euo pipefail
ROOT="android/player"
rm -rf "$ROOT"
mkdir -p "$ROOT"
mkdir -p "$ROOT/app"
printf '%s' '' | base64 -d > "$ROOT/app/build.gradle.kts"
mkdir -p "$ROOT/app/src/main"
printf '%s' '' | base64 -d > "$ROOT/app/src/main/AndroidManifest.xml"
mkdir -p "$ROOT/app/src/main/java/com/kristalstreams/player"
printf '%s' '' | base64 -d > "$ROOT/app/src/main/java/com/kristalstreams/player/ChannelListAdapter.kt"
mkdir -p "$ROOT/app/src/main/java/com/kristalstreams/player"
printf '%s' '